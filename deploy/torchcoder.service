[Unit]
Description=TorchCoder Web Service
After=network.target

[Service]
Type=simple
User=torchcoder
Group=torchcoder
WorkingDirectory=/srv/torchcoder/app
Environment=HOST=0.0.0.0
Environment=PORT=8000
Environment=TORCHCODER_DB_PATH=/srv/torchcoder/data/torchcoder.db
Environment=PUBLIC_ORIGIN=https://simuler.cn
Environment=SESSION_COOKIE_SECURE=true
ExecStart=/usr/bin/python /srv/torchcoder/app/start_web.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
